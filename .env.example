# =============================================================================
# ops-task-manager-backend 环境变量模板（前缀 TASK_MANAGER_）
# 用法：复制为启动命令当前工作目录下的 .env，或 export 后启动后端
# 根目录 .env.example 与本文件保持一致，均使用后端实际读取的变量名
# 环境变量优先于 .env；初始管理员的命令行参数优先于两者
# 列表类：多个值用英文逗号分隔（如 CORS）
# =============================================================================

# --- server ---
TASK_MANAGER_SERVER_HOST=0.0.0.0
TASK_MANAGER_SERVER_PORT=8080
# 浏览器前端允许的精确来源，多个来源用逗号分隔；同源部署可留空
# 跨源示例：https://task.example.com,http://localhost:5173（无路径、无末尾斜杠，不使用 *）
# 容器部署须将此项写入实际传给 docker --env-file 的配置文件
TASK_MANAGER_SERVER_CORS_ORIGINS=

# --- database ---
TASK_MANAGER_DATABASE_DSN=postgres://taskmgr:taskmgr@localhost:5432/taskmgr?sslmode=disable

# --- 初始管理员（仅数据库中还没有用户时创建，不会重置已有账户）---
TASK_MANAGER_INIT_ADMIN_USERNAME=admin
# 请替换为自己的强密码；留空时程序沿用默认值 Admin@12345
TASK_MANAGER_INIT_ADMIN_PASSWORD=

# --- auth ---
# 本地 HTTP 开发设为 false；生产 HTTPS 必须设为 true（程序默认 true）
TASK_MANAGER_AUTH_COOKIE_SECURE=false
TASK_MANAGER_AUTH_JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
TASK_MANAGER_AUTH_JWT_EXPIRY_HOURS=24
TASK_MANAGER_AUTH_LOGIN_LOCK_ATTEMPTS=5
TASK_MANAGER_AUTH_LOGIN_LOCK_MINUTES=15

# MCP 与 OAuth 请登录「系统设置 → MCP 与 OAuth 管理」配置，保存即生效。
# 升级时仅首次导入旧 TASK_MANAGER_MCP_* / TASK_MANAGER_OAUTH_* 值；之后以数据库为准。

# --- scheduler ---
TASK_MANAGER_SCHEDULER_NOTIFICATION_SCAN_INTERVAL=10m

# --- smtp（host 与 from 均非空时启用邮件；否则跳过）---
# TASK_MANAGER_SMTP_HOST=smtp.example.com
TASK_MANAGER_SMTP_PORT=587
# TASK_MANAGER_SMTP_USERNAME=
# TASK_MANAGER_SMTP_PASSWORD=
# TASK_MANAGER_SMTP_FROM=运维任务管理器 <noreply@example.com>

# --- log ---
TASK_MANAGER_LOG_LEVEL=info
TASK_MANAGER_LOG_FORMAT=json
